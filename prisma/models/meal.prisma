model Meal {
    id     Int  @id @default(autoincrement())
    user   User @relation(fields: [userId], references: [id])
    userId Int

    name        String
    mealType    MealType
    calories    Float
    protein     Float
    fat         Float
    carbs       Float
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum MealType {
    BREAKFAST
    LUNCH
    DINNER
    SNACK
}
